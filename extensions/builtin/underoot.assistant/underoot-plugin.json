{
  "id": "underoot.assistant",
  "name": "论文审阅助手",
  "version": "0.4.0",
  "apiVersion": 1,
  "runtime": "builtin",
  "entry": "activate.mjs",
  "author": "underoot",
  "license": "MIT",
  "description": "本地优先、修改段落增量审阅、上下文缓存、调用预算与就地差异预览。",
  "permissions": [
    "project.read",
    "selection.read",
    "pdf.read",
    "ai.invoke",
    "suggestions.propose"
  ],
  "contributes": {
    "commands": [
      {
        "id": "underoot.assistant.open",
        "title": "论文助手与修改建议",
        "when": "editor",
        "handler": "assistant.open"
      }
    ]
  }
}

{
  "id": "underoot.publishing",
  "name": "学术传播与投稿",
  "version": "0.10.6",
  "apiVersion": 1,
  "runtime": "builtin",
  "entry": "activate.mjs",
  "author": "underoot",
  "license": "MIT",
  "description": "可编辑提纲、完整署名与单位图标、项目二维码；多轮实际编译排版与版心对齐，原项目内安全重排及对话修订。",
  "permissions": [
    "project.read",
    "ai.invoke"
  ],
  "contributes": {
    "commands": [
      {
        "id": "underoot.publishing.slides",
        "title": "生成 LaTeX Slides",
        "when": "editor",
        "handler": "publishing.slides"
      },
      {
        "id": "underoot.publishing.poster",
        "title": "生成学术 Poster",
        "when": "editor",
        "handler": "publishing.poster"
      },
      {
        "id": "underoot.publishing.continue",
        "title": "继续调整 Slides / Poster",
        "when": "editor",
        "handler": "publishing.chat"
      },
      {
        "id": "underoot.publishing.template",
        "title": "转投 · 换模板（保留旧稿）",
        "when": "editor",
        "handler": "publishing.template"
      }
    ]
  }
}

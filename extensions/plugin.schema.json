{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "underoot Extension Manifest v1",
  "type": "object",
  "required": ["id", "name", "version", "apiVersion", "entry", "contributes"],
  "properties": {
    "$schema": {"type":"string"},
    "id": {"type":"string", "pattern":"^[a-z][a-z0-9-]{1,39}\\.[a-z][a-z0-9.-]{1,79}$"},
    "name": {"type":"string", "minLength":1, "maxLength":80},
    "version": {"type":"string", "pattern":"^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$"},
    "apiVersion": {"const":1}, "runtime": {"const":"iframe"},
    "entry": {"type":"string", "pattern":"^[^\\\\:]+\\.html$", "maxLength":180},
    "description": {"type":"string", "maxLength":500}, "author": {"type":"string", "maxLength":100}, "license": {"type":"string", "maxLength":80},
    "permissions": {"type":"array", "uniqueItems":true, "items":{"enum":["project.read","selection.read","pdf.read","ai.invoke","suggestions.propose","comments.read","comments.write","storage"]}},
    "contributes": {"type":"object", "required":["commands"], "properties":{"commands":{"type":"array", "minItems":1,"maxItems":12,"items":{"type":"object","required":["id","title"],"properties":{"id":{"type":"string"},"title":{"type":"string","minLength":1,"maxLength":80},"when":{"enum":["editor","workspace","all"]}},"additionalProperties":false}}},"additionalProperties":false}
  },
  "additionalProperties": false
}

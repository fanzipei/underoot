{
  "name": "underoot",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "description": "可插件扩展、可本地部署的 vibe research 协作平台",
  "main": "server/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --disable-warning=ExperimentalWarning scripts/build.mjs && node --disable-warning=ExperimentalWarning server/index.js",
    "serve": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node scripts/build.mjs --watch",
    "test": "node scripts/smoke-test.mjs",
    "test:isolated": "node scripts/test-isolated.mjs",
    "test:research": "node scripts/test-isolated.mjs --research",
    "test:platform": "node scripts/test-isolated.mjs --platform",
    "test:wasm": "node scripts/wasm-test.mjs",
    "test:wasm:modern": "node scripts/tex-cache-test.mjs && node scripts/test-isolated.mjs --modern-wasm",
    "test:git": "node scripts/git-sync-test.mjs",
    "test:publishing": "node scripts/publishing-unit-test.mjs && node scripts/publishing-editorial-test.mjs && node scripts/test-isolated.mjs --publishing",
    "test:publishing:quality": "node scripts/publishing-quality-test.mjs",
    "test:assistant": "node scripts/assistant-economy-unit.mjs && node scripts/test-isolated.mjs --economy",
    "test:templates": "node scripts/test-isolated.mjs --templates",
    "test:publishing:studio": "node scripts/test-isolated.mjs --publishing-studio",
    "test:publishing:fit": "node scripts/publishing-fit-unit-test.mjs && node scripts/publishing-standalone-test.mjs && node scripts/publishing-evidence-test.mjs",
    "test:publishing:layout": "node scripts/publishing-layout-quality-test.mjs",
    "test:tables": "node scripts/tables-unit-test.mjs && node scripts/table-regions-test.mjs && node scripts/test-isolated.mjs --tables",
    "test:agent": "node scripts/test-isolated.mjs --agent-api",
    "test:mcp": "node scripts/test-isolated.mjs --mcp"
  },
  "keywords": [
    "latex",
    "overleaf",
    "editor"
  ],
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@replit/codemirror-vim": "^6.4.0",
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "codemirror": "^6.0.2",
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.4.17",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "katex": "^0.19.1",
    "lib0": "^0.2.119",
    "marked": "^18.2.0",
    "multer": "^2.5.0",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "1.5.4",
    "ws": "^8.22.1",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "esbuild": "^0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fanzipei/underoot.git"
  },
  "overrides": {
    "archiver": {
      "readdir-glob": "^4.0.0"
    }
  }
}

# 复制为 .env 后按需修改；已存在的系统环境变量优先，不会被本文件覆盖。

# 服务监听端口（默认 3000）
# PORT=3000

# ---- 账号审批 ----
# 仅作为「管理员未在后台设置过」时的默认值；推荐直接在「账号管理」页用开关切换
# 设为 0 则默认开放注册（写进 .env 后需重启服务）
# LATEXSTUDIO_REQUIRE_APPROVAL=1
# 同一 IP 10 分钟内最多注册次数，默认 5；设 0 关闭限流（仅建议内网 / 测试用）
# LATEXSTUDIO_REGISTER_MAX=5

# ---- 面向公网暴露时的安全加固 ----
# 经 HTTPS 反向代理（Nginx / Caddy）对外时开启；会让认证 Cookie 带上 Secure 标记，
# 并输出 HSTS 头。本地 http 调试无需设置。
# LATEXSTUDIO_SECURE_COOKIE=1
# LATEXSTUDIO_HSTS=1
# 信任的反向代理来源（1/loopback/具体 IP 或 CIDR），用于正确识别客户端真实 IP 与 HTTPS
# LATEXSTUDIO_TRUST_PROXY=loopback

# ---- 内置管理员 ----
# 不设密码时首次启动会随机生成，并打印到日志、写入 data/admin-password.txt
# LATEXSTUDIO_ADMIN_EMAIL=admin@latex.studio
# LATEXSTUDIO_ADMIN_PASSWORD=换成你自己的强密码

# ---- 会话签名密钥（默认自动生成并保存在 data/secret.key）----
# LATEXSTUDIO_SECRET=

# ---- 共享服务器上停用演示账号（公网暴露时建议开启）----
# LATEXSTUDIO_DISABLE_DEMO=1

# ---- 从 GitHub 仓库新建项目 ----
# 仅导入私有仓库、或需要更高 API 限流额度时配置（也可用 GITHUB_TOKEN）
# LATEXSTUDIO_GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# ---- 编译引擎 ----
# 服务端默认引擎（项目可在「⋯ → 编译引擎」里单独覆盖）。
# pdfLaTeX 用 latexmk；要与 Overleaf 默认排版一致请设为 latexmk 并在项目里选它。
# LATEX_ENGINE=latexmk
# TeX Live 装在非标准位置时指定其 bin 目录（含 pdflatex）；常见用户级路径会自动探测
# Linux 示例：~/.texlive/2026/bin/x86_64-linux
# LATEXSTUDIO_TEXLIVE_BIN=

# ---- underoot AI 工作台 ----
# API 地址、模型和密钥通过管理员「AI API 配置」页面设置；密钥加密保存在数据库。
# 默认只允许公网 HTTPS API。本地模型仅在明确需要时开启（重启后生效）。
# LATEXSTUDIO_AI_ALLOW_LOCAL=0

# ---- GitLab 私有部署（仅管理员显式开启时允许内网 / HTTP） ----
# Git Token 由各用户在项目「更多 → GitHub / GitLab 版本同步」中独立填写。
# UNDEROOT_GIT_ALLOW_LOCAL=0
